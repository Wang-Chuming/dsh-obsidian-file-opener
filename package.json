{
  "name": "@dsh-external/dsh-obsidian-file-opener",
  "version": "0.3.0",
  "private": true,
  "description": "One-click Obsidian file opener for DeepSeek Harness: clicking a vault file reference in the Web conversation (or asking the agent through the open_in_obsidian tool) launches the Obsidian app instead of the in-app preview.",
  "license": "MIT",
  "author": "Wang-Chuming",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "obsidian",
    "obsidian-vault",
    "file-opener",
    "web-gui",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wang-Chuming/dsh-obsidian-file-opener.git"
  },
  "homepage": "https://github.com/Wang-Chuming/dsh-obsidian-file-opener#readme",
  "bugs": {
    "url": "https://github.com/Wang-Chuming/dsh-obsidian-file-opener/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check test/host.test.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
